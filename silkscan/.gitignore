# Committed exceptions: the served model (configs/serving.yaml), its known-malicious hash list and the
# parity records used to check a model on another machine. Evaluation outputs stay ignored.
!/runs/laptop/
/runs/laptop/*
!/runs/laptop/20261017-125021-370-471c29b9/
/runs/laptop/20261017-125021-370-471c29b9/evaluations/
/runs/laptop/20261017-125021-370-471c29b9/explanations/
!/work/win64-laptop/
/work/win64-laptop/*
!/work/win64-laptop/hashes/
!/work/win64-laptop/hashes/known_malicious.npy
!/work/z_transfer/
/work/z_transfer/*
!/work/z_transfer/parity/
