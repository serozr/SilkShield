# SilkShield Environment Variables
# Copy to .env. Never commit .env or paste secrets into chat.

# VirusTotal API key (optional)
VIRUSTOTAL_API_KEY=

# AI provider: "local" (local llama.cpp), "granite" (watsonx.ai), or "demo"
AI_PROVIDER=local

# Local llama.cpp OpenAI-compatible endpoint (no API key required)
LOCAL_LLM_API_URL=http://127.0.0.1:8080/v1/chat/completions
LOCAL_LLM_MODEL_ID=local-granite

# IBM watsonx.ai Runtime (only required for AI_PROVIDER=granite)
GRANITE_API_URL=https://us-south.ml.cloud.ibm.com
GRANITE_API_KEY=
WATSONX_PROJECT_ID=
GRANITE_MODEL_ID=ibm/granite-4-h-small

# Cache TTL in seconds
CACHE_TTL=3600
