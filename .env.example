# SilkShield Environment Variables
# Copy this file to .env and fill in your values

# VirusTotal API Key (https://www.virustotal.com/gui/my-apikey)
VIRUSTOTAL_API_KEY=

# AI Provider: "granite" or "demo"
AI_PROVIDER=demo

# IBM Granite (only needed if AI_PROVIDER=granite)
GRANITE_API_URL=
GRANITE_API_KEY=
GRANITE_MODEL_ID=ibm/granite-13b-chat-v2

# Cache TTL in seconds
CACHE_TTL=3600
